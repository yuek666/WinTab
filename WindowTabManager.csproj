<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>WindowTabManager</AssemblyName>
    <RootNamespace>WindowTabManager</RootNamespace>
    <OutputPath>bin-preview-v2\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\WindowTabManager.ico</ApplicationIcon>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Runtime.Serialization"/><Reference Include="System.Xml"/>
    <Compile Include="src\*.cs"/>
    <EmbeddedResource Include="assets\WindowTabManager.ico"><LogicalName>WindowTabManager.AppIcon.ico</LogicalName></EmbeddedResource>
    <None Include="assets\WindowTabManager.svg"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
